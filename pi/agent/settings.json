{
  "lastChangelogVersion": "0.75.3",
  "steeringMode": "all",
  "autoUpdate": true,
  "transport": "auto",
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "high",
  "skills": [
    "../.codex/skills"
  ],
  "packages": [
    "npm:@ifi/oh-pi-themes",
    "npm:@dreki-gg/pi-context7",
    {
      "source": "npm:@plannotator/pi-extension",
      "skills": []
    },
    "npm:pi-cache-graph",
    "npm:context-mode"
  ],
  "extensions": [
    "extensions/plannotator-events/index.ts",
    "extensions/codex-native/index.ts",
    "extensions/token-burden/index.ts",
    "extensions/vim/index.ts",
    "extensions/tasks/index.ts",
    "extensions/system-prompt/index.ts",
    "extensions/spawn/index.ts"
  ],
  "enabledModels": [
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-5.4",
    "openai-codex/gpt-5.4-mini"
  ],
  "theme": "catppuccin-mocha",
  "hideThinkingBlock": false,
  "editorPaddingX": 0,
  "terminal": {
    "clearOnShrink": false,
    "showTerminalProgress": true
  },
  "quietStartup": true,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "enableInstallTelemetry": false
}
