{
  "lastChangelogVersion": "0.84.2",
  "steeringMode": "all",
  "autoUpdate": true,
  "transport": "auto",
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "skills": [
    "~/.agents/skills"
  ],
  "packages": [
    "npm:@ifi/oh-pi-themes",
    {
      "source": "npm:@dreki-gg/pi-context7",
      "extensions": [
        "-extensions/context7/index.ts"
      ]
    },
    {
      "source": "npm:@plannotator/pi-extension",
      "skills": []
    },
    "npm:pi-cache-graph",
    "npm:@dietrichgebert/ponytail",
    "npm:@injaneity/pi-computer-use"
  ],
  "theme": "light/tokyo-night",
  "hideThinkingBlock": false,
  "editorPaddingX": 0,
  "terminal": {
    "clearOnShrink": false,
    "showTerminalProgress": true
  },
  "quietStartup": true,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 20000
  },
  "showCacheMissNotices": true,
  "defaultProjectTrust": "always",
  "markdown": {
    "mermaid": "streaming"
  },
  "showHardwareCursor": true,
  "tuiMode": "fullscreen",
  "enabledModels": [
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra"
  ]
}
