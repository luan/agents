{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,

  "plugin": ["@tarquinen/opencode-dcp@latest"],

  "instructions": ["AGENTS.md"],

  "compaction": {
    "auto": true,
    "prune": true,
  },

  "permission": "allow",

  "mcp": {
    "context7": {
      "type": "local",
      "command": ["bunx", "-y", "@upstash/context7-mcp"],
      "environment": {},
    },
    "blueprint": {
      "type": "local",
      "command": ["ct", "mcp", "blueprint"],
      "environment": {},
    },
  },
}
