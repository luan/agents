{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": true,

	"plugin": ["@tarquinen/opencode-dcp@latest", "./plugins/lens.ts"],

	"instructions": ["AGENTS.md", "CLAUDE.local.md"],
	"skills": {
		"paths": ["~/.agents/skills"]
	},

	"compaction": {
		"auto": true,
		"prune": true
	},

	"permission": "allow",

	"mcp": {
		"context7": {
			"type": "local",
			"command": ["bunx", "-y", "@upstash/context7-mcp"],
			"environment": {}
		},
		"lens": {
			"type": "local",
			"command": ["ct", "mcp", "lens"],
			"environment": {}
		},
		"fff": {
			"type": "local",
			"command": ["fff-mcp"],
			"enabled": true
		}
	}
}
