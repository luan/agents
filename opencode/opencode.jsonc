{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,

  "plugin": ["@tarquinen/opencode-dcp@latest", "./plugins/lens.js"],

  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": ["~/.agents/skills"],
  },

  "compaction": {
    "auto": true,
    "prune": true,
  },

  "permission": "allow",

  "mcp": {
    "context7": {
      "type": "local",
      "command": ["bunx", "-y", "@upstash/context7-mcp"],
      "environment": {},
    },
    "vault": {
      "type": "local",
      "command": ["ct", "mcp", "vault"],
      "environment": {},
    },
    "sym": {
      "type": "local",
      "command": ["ct", "mcp", "sym"],
      "environment": {},
    },
    "lens": {
      "type": "local",
      "command": ["ct", "mcp", "lens"],
      "environment": {},
    },
  },
}
