{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,

  "plugin": [
    "context-mode",
    "@tarquinen/opencode-dcp@latest",
    "./plugins/lens.js",
  ],

  "instructions": ["AGENTS.md", "CLAUDE.local.md"],
  "skills": {
    "paths": ["~/.agents/skills"],
  },

  "compaction": {
    "auto": true,
    "prune": true,
  },

  "permission": "allow",

  "mcp": {
    "context7": {
      "type": "local",
      "command": ["bunx", "-y", "@upstash/context7-mcp"],
      "environment": {},
    },
    "context-mode": {
      "type": "local",
      "command": ["context-mode"],
    },
    "source": {
      "type": "local",
      "command": ["ct", "mcp", "source"],
      "environment": {},
    },
    "lens": {
      "type": "local",
      "command": ["ct", "mcp", "lens"],
      "environment": {},
    },
    "vault": {
      "type": "local",
      "command": ["ct", "mcp", "vault"],
      "environment": {},
    },
    "fff": {
      "type": "local",
      "command": ["fff-mcp"],
      "enabled": true,
    },
  },
}
