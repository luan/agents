#!/usr/bin/env sh
set -eu

script=$0
while [ -L "$script" ]; do
  target=$(readlink "$script")
  case "$target" in
    /*) script=$target ;;
    *) script=$(dirname "$script")/$target ;;
  esac
done

repo=$(cd "$(dirname "$script")/.." && pwd)

case "${1:-}" in
  codex-sym-nudge)
    exec python3 "$repo/hooks/codex/sym_nudge.py"
    ;;
  gt-session-start)
    exec bash "$repo/plugins/gt/hooks/session-start.sh"
    ;;
  gt-validate-git)
    exec bash "$repo/plugins/gt/hooks/validate-git-commands.sh"
    ;;
  *)
    echo "usage: agents-hook {codex-sym-nudge|gt-session-start|gt-validate-git}" >&2
    exit 64
    ;;
esac
