    "@mozilla/readability": "^0.5.0",
    "@shikijs/cli": "^4.0.2",
    "linkedom": "^0.16.0",
    "node-pty": "^1.1.0",
    "p-limit": "^6.1.0",
    "partial-json": "^0.1.7",
    "tree-sitter-bash": "^0.25.1",
    "turndown": "^7.2.0",
    "typebox": "^1.1.34",
    "unpdf": "^1.4.0",
    "web-tree-sitter": "^0.26.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
