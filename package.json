{
  "name": "agents",
  "private": true,
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "biome check --write --error-on-warnings .",
    "knip": "knip --include files,dependencies,unlisted,unresolved",
    "typecheck": "tsgo --noEmit --pretty false --project tsconfig.typecheck.json",
    "test": "find \"$PWD/pi/agent/extensions\" -name '*.test.ts' -print0 | xargs -0 -n1 -P4 bun test --timeout 10000",
    "prepare": "husky"
  },
  "dependencies": {
    "@binclusive/tree-sitter-swift-wasm": "0.1.0",
    "@earendil-works/pi-agent-core": "0.84.0",
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@pierre/diffs": "^1.2.4",
    "@plannotator/pi-extension": "^0.19.20",
    "@xterm/headless": "^6.0.0",
    "diff": "8.0.4",
    "gpt-tokenizer": "3.4.0",
    "jiti": "2.7.0",
    "mustache": "^4.2.0",
    "node-pty": "^1.1.0",
    "openai": "6.26.0",
    "shiki": "3.23.0",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "typebox": "^1.1.34",
    "web-tree-sitter": "^0.26.7",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/mustache": "^4.2.6",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260501.1",
    "husky": "^9.1.7",
    "knip": "6.32.2"
  }
}
