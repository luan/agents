    "@shikijs/cli": "^4.0.2",
    "croner": "^10.0.1",
    "gpt-tokenizer": "^3.4.0",
    "highlight.js": "^10.7.3",
    "linkedom": "^0.16.0",
    "mustache": "^4.2.0",
    "nanoid": "^5.0.0",
