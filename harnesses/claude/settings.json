{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GIT_USERNAME": "luan"
  },
  "disableAllHooks": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "uv run $HOME/.claude/statusline.py",
    "padding": 0,
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false,
    "slack@claude-plugins-official": true,
    "datadog@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "github@anthropic-plugin-directory": true
  },
  "feedbackDrafts": "notify",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "askUserQuestionTimeout": "never",
  "dialogExpiry": "never",
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-or-agents-md"
      }
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "idleCompaction": true,
  "switchModelsOnFlag": false,
  "inputNeededNotifEnabled": false,
  "outputStyle": "Proactive"
}