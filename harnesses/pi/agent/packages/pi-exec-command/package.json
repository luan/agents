{
  "name": "@luan.sh/pi-exec-command",
  "version": "0.3.10",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luan/agents.git",
    "directory": "harnesses/pi/agent/packages/pi-exec-command"
  },
  "description": "Bounded shell execution with persistent PTY sessions for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts",
      "./node_modules/@luan.sh/pi-libtui/src/extension.ts"
    ],
    "image": "https://pi.luan.sh/media/previews/pi-exec-command-bdc338239909.png",
    "video": "https://pi.luan.sh/media/previews/pi-exec-command-00eaa4fd94c5.mp4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": ">=1.0.0",
    "typebox": "*"
  },
  "dependencies": {
    "@luan.sh/pi-libactions": "workspace:*",
    "@luan.sh/pi-libtui": "workspace:*",
    "@luan.sh/pi-xsettings": "workspace:*"
  },
  "bundledDependencies": [
    "@luan.sh/pi-libactions",
    "@luan.sh/pi-libtui",
    "@luan.sh/pi-xsettings"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures test"
  },
  "publishAliases": [
    "pi-exec-command"
  ]
}
