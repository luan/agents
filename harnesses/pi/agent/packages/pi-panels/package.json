{
  "name": "@luan.sh/pi-panels",
  "version": "0.3.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luan/agents.git",
    "directory": "harnesses/pi/agent/packages/pi-panels"
  },
  "description": "Generic contributed side-panel host for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts",
      "./node_modules/@luan.sh/pi-libtui/src/extension.ts"
    ],
    "image": "https://pi.luan.sh/media/previews/pi-panels-e69474de1ee3.png",
    "video": "https://pi.luan.sh/media/previews/pi-panels-ae3c28bfa509.mp4"
  },
  "dependencies": {
    "@luan.sh/pi-libactions": "workspace:*",
    "@luan.sh/pi-libtui": "workspace:*"
  },
  "bundledDependencies": [
    "@luan.sh/pi-libactions",
    "@luan.sh/pi-libtui"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures test"
  },
  "publishAliases": [
    "pi-panels"
  ]
}
