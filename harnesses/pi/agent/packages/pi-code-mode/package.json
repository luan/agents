{
  "name": "pi-code-mode",
  "private": true,
  "version": "0.1.0",
  "description": "Restricted JavaScript tool composition for Pi",
  "type": "module",
  "keywords": ["pi-package"],
  "exports": {
    ".": "./src/index.ts",
    "./sdk": "./src/sdk.ts"
  },
  "pi": {
    "extensions": ["./src/extension.ts", "./node_modules/pi-libtui/src/extension.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "pi-libtui": "workspace:*",
    "pi-xsettings": "workspace:*"
  },
  "bundledDependencies": ["pi-libtui", "pi-xsettings"],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures \"$PWD/test\""
  }
}
