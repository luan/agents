{
  "name": "@luan.sh/pi-view-image",
  "version": "0.3.10",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luan/agents.git",
    "directory": "harnesses/pi/agent/packages/pi-view-image"
  },
  "description": "Codex-compatible native image attachment tool for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts",
      "./node_modules/@luan.sh/pi-libtui/src/extension.ts"
    ],
    "image": "https://pi.luan.sh/media/previews/pi-view-image-3b76f3119bb5.png",
    "video": "https://pi.luan.sh/media/previews/pi-view-image-62df21208d2a.mp4"
  },
  "dependencies": {
    "@luan.sh/pi-libtui": "workspace:*",
    "@luan.sh/pi-xsettings": "workspace:*"
  },
  "bundledDependencies": [
    "@luan.sh/pi-libtui",
    "@luan.sh/pi-xsettings"
  ],
  "peerDependencies": {
    "@earendil-works/pi-tui": ">=1.0.0",
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "typebox": "*",
    "@earendil-works/pi-ai": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3",
    "@earendil-works/pi-ai": "1.0.0"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures test"
  },
  "publishAliases": [
    "pi-view-image"
  ]
}
