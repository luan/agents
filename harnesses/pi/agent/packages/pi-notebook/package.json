{
  "name": "@luan.sh/pi-notebook",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luan/agents.git",
    "directory": "harnesses/pi/agent/packages/pi-notebook"
  },
  "description": "Persistent Deno JavaScript and TypeScript notebooks for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts",
      "./node_modules/@luan.sh/pi-libtui/src/extension.ts"
    ]
  },
  "dependencies": {
    "@luan.sh/pi-code-mode": "workspace:*",
    "@luan.sh/pi-libtui": "workspace:*",
    "typebox": "*"
  },
  "bundledDependencies": [
    "@luan.sh/pi-code-mode",
    "@luan.sh/pi-libtui"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3",
    "@earendil-works/pi-tui": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures test"
  }
}
