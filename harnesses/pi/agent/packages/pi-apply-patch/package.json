{
  "name": "pi-apply-patch",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Codex-compatible apply_patch tool for Pi",
  "type": "module",
  "keywords": ["pi-package"],
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": ["./src/extension.ts", "./node_modules/pi-libtui/src/extension.ts"]
  },
  "dependencies": {
    "pi-code-mode": "workspace:*",
    "pi-libtui": "workspace:*"
  },
  "bundledDependencies": ["pi-code-mode", "pi-libtui"],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures test"
  }
}
