{
  "name": "@luan.sh/pi-copy-mode",
  "version": "0.3.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luan/agents.git",
    "directory": "harnesses/pi/agent/packages/pi-copy-mode"
  },
  "description": "Vim-style transcript selection, copying, annotations, and reactions for Pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "copy-mode",
    "vim",
    "transcript",
    "annotations",
    "comments",
    "reactions"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./annotations": "./src/annotations/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts",
      "./node_modules/@luan.sh/pi-libtui/src/extension.ts"
    ],
    "image": "https://pi.luan.sh/media/previews/pi-copy-mode-9b8c74e7ea97.png",
    "video": "https://pi.luan.sh/media/previews/pi-copy-mode-7a4bd7d42c6a.mp4"
  },
  "dependencies": {
    "@luan.sh/pi-libactions": "workspace:*",
    "@luan.sh/pi-libtui": "workspace:*",
    "@luan.sh/pi-xsettings": "workspace:*"
  },
  "bundledDependencies": [
    "@luan.sh/pi-libactions",
    "@luan.sh/pi-libtui",
    "@luan.sh/pi-xsettings"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures test"
  },
  "publishAliases": [
    "pi-copy-mode"
  ]
}
