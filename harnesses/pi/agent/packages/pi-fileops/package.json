{
  "name": "@luan.sh/pi-fileops",
  "version": "0.3.9",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luan/agents.git",
    "directory": "harnesses/pi/agent/packages/pi-fileops"
  },
  "description": "Native file operations for Pi, with structured apply_patch diffs",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts",
      "./node_modules/@luan.sh/pi-libtui/src/extension.ts"
    ],
    "image": "https://pi.luan.sh/media/previews/pi-fileops-fd6d191a4760.png",
    "video": "https://pi.luan.sh/media/previews/pi-fileops-fcf6128b5f4c.mp4"
  },
  "dependencies": {
    "@luan.sh/pi-libtui": "workspace:*"
  },
  "bundledDependencies": [
    "@luan.sh/pi-libtui"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures test"
  },
  "publishAliases": [
    "pi-fileops"
  ]
}
