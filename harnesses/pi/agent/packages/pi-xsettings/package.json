{
  "name": "@luan.sh/pi-xsettings",
  "version": "0.3.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luan/agents.git",
    "directory": "harnesses/pi/agent/packages/pi-xsettings"
  },
  "description": "Shared typed settings and settings UI for Pi extensions",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./sdk": "./src/sdk.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts",
      "./node_modules/@luan.sh/pi-libtui/src/extension.ts"
    ],
    "image": "https://pi.luan.sh/media/previews/pi-xsettings-25c1f13ef32f.png",
    "video": "https://pi.luan.sh/media/previews/pi-xsettings-6661ed0cbe89.mp4"
  },
  "dependencies": {
    "@luan.sh/pi-libactions": "workspace:*",
    "@luan.sh/pi-libtui": "workspace:*",
    "proper-lockfile": "4.1.2",
    "smol-toml": "1.8.0",
    "typebox": "1.3.15"
  },
  "bundledDependencies": [
    "@luan.sh/pi-libactions",
    "@luan.sh/pi-libtui"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/bun": "^1.3.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures test"
  },
  "publishAliases": [
    "pi-xsettings"
  ]
}
