{
  "name": "pi-model-roles",
  "private": true,
  "version": "0.1.0",
  "description": "Named model and thinking profiles for Pi",
  "type": "module",
  "keywords": ["pi-package"],
  "exports": {
    ".": "./src/index.ts",
    "./sdk": "./src/sdk.ts"
  },
  "pi": {
    "extensions": ["./src/extension.ts", "./node_modules/pi-libtui/src/extension.ts"]
  },
  "dependencies": {
    "pi-libactions": "workspace:*",
    "pi-libcontext": "workspace:*",
    "pi-libtui": "workspace:*",
    "pi-xsettings": "workspace:*",
    "typebox": "1.3.15"
  },
  "bundledDependencies": ["pi-libactions", "pi-libcontext", "pi-libtui", "pi-xsettings"],
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures test"
  }
}
