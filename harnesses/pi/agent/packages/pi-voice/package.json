{
  "name": "@luan.sh/pi-voice",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luan/agents.git",
    "directory": "harnesses/pi/agent/packages/pi-voice"
  },
  "description": "Codex realtime voice and editable dictation for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts",
      "./node_modules/@luan.sh/pi-libtui/src/extension.ts"
    ]
  },
  "dependencies": {
    "@luan.sh/pi-libtui": "workspace:*",
    "@luan.sh/pi-xsettings": "workspace:*",
    "@luan.sh/pi-libactions": "workspace:*",
    "ws": "^8.21.3",
    "undici": "8.10.2",
    "proxy-from-env": "2.1.0",
    "https-proxy-agent": "^7.0.6",
    "selfsigned": "^5.5.0",
    "@luan.sh/pi-developer-messages": "workspace:*"
  },
  "bundledDependencies": [
    "@luan.sh/pi-libtui",
    "@luan.sh/pi-xsettings",
    "@luan.sh/pi-libactions",
    "@luan.sh/pi-developer-messages"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "typebox": "*",
    "@earendil-works/pi-ai": ">=1.0.0",
    "@earendil-works/pi-tui": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3",
    "@earendil-works/pi-tui": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@types/ws": "^8.18.1",
    "typebox": "1.3.15"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures test"
  }
}
