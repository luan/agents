{
  "name": "pi-side-panel",
  "private": true,
  "version": "0.1.0",
  "description": "Generic contributed side-panel host for Pi",
  "type": "module",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./src/extension.ts", "./node_modules/pi-libtui/src/extension.ts"]
  },
  "dependencies": {
    "pi-libactions": "workspace:*",
    "pi-libtui": "workspace:*"
  },
  "bundledDependencies": ["pi-libactions", "pi-libtui"],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures test"
  }
}
