{
  "name": "@luan.sh/pi-prompt-storage",
  "version": "0.3.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luan/agents.git",
    "directory": "harnesses/pi/agent/packages/pi-prompt-storage"
  },
  "description": "Prompt stash and searchable session history for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts",
      "./node_modules/@luan.sh/pi-libtui/src/extension.ts"
    ],
    "image": "https://pi.luan.sh/media/previews/pi-prompt-storage-5627a140e645.png",
    "video": "https://pi.luan.sh/media/previews/pi-prompt-storage-8e5eab2e63de.mp4"
  },
  "dependencies": {
    "@luan.sh/pi-libtui": "workspace:*"
  },
  "bundledDependencies": [
    "@luan.sh/pi-libtui"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures test"
  },
  "publishAliases": [
    "pi-prompt-storage"
  ]
}
