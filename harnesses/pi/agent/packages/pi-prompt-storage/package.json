	"bundledDependencies": ["pi-libtui"],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.84.2",
		"@earendil-works/pi-tui": "0.84.2",
		"@types/bun": "^1.3.0",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"typecheck": "tsc --build",
		"test": "bun test --only-failures test"
	}
