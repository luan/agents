{
	"name": "pi-prompt-storage",
	"private": true,
	"version": "0.1.0",
	"description": "Prompt stash and searchable session history for Pi",
	"type": "module",
	"keywords": ["pi-package"],
	"exports": { ".": "./src/index.ts" },
	"pi": { "extensions": ["./src/extension.ts", "./node_modules/pi-libtui/src/extension.ts"] },
