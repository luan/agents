{
  "name": "@luan.sh/pi-libtui",
  "version": "0.3.11",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luan/agents.git",
    "directory": "harnesses/pi/agent/packages/pi-libtui"
  },
  "description": "Shared TUI components and generic mouse compatibility for local Pi extensions",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./diff": "./src/diff/index.ts",
    "./editor": "./src/editor.ts",
    "./folding": "./src/folding.ts",
    "./mouse": "./src/mouse.ts",
    "./selection": "./src/selection.ts",
    "./stream": "./src/stream.ts",
    "./terminal": "./src/terminal/output.ts",
    "./tool": "./src/tool/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "themes": [
      "./themes"
    ],
    "image": "https://pi.luan.sh/media/previews/pi-libtui-1820a03ca387.png",
    "video": "https://pi.luan.sh/media/previews/pi-libtui-e7ff85f140d3.mp4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "@pierre/diffs": "1.3.5",
    "@xterm/headless": "6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/bun": "^1.3.0"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures --timeout 15000 test"
  },
  "bundledDependencies": [],
  "publishAliases": [
    "pi-libtui"
  ]
}
