{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "CT_LENS_HOST=codex ct hook lens-session-start",
            "statusMessage": "Initializing Lens",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "ct sym hook remind --format=claude-code",
            "statusMessage": "Loading sym guidance",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "ct hook gt-session-start",
            "statusMessage": "Checking Graphite workflow",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CT_LENS_HOST=codex ct hook lens-pre-tool",
            "statusMessage": "Checking Lens guard",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ct hook codex-sym-nudge",
            "statusMessage": "Checking for sym lookup",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "ct hook gt-validate-git",
            "statusMessage": "Checking Graphite command policy",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CT_LENS_HOST=codex ct hook lens-post-tool",
            "statusMessage": "Recording Lens event",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CT_LENS_HOST=codex ct hook lens-turn-end",
            "statusMessage": "Closing Lens turn",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "CT_LENS_HOST=codex ct hook lens-agent-end",
            "statusMessage": "Checking Lens health",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
