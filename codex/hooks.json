{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/sync-git-tool.sh",
            "statusMessage": "Syncing repository stack skills"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/plannotator",
            "timeout": 345600
          }
        ]
      }
    ]
  }
}
